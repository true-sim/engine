// The particle modules' dispatch (effects.md E24), included by particles/simulate.slang: each stage's switch over the
// opcodes, a case per module having it, reading its fields into its struct and calling it.
{imports}
{opcodes}
/** Modules of the kernel. */
static const uint MODULE_COUNT = {count};

/** Stages (modules.properties): bit i of an op word's stages, from bit 16, is stage i. */
static const uint STAGE_INIT = 1;
static const uint STAGE_FORCE = 2;
static const uint STAGE_AFTER = 4;
static const uint STAGE_COLLIDE = 8;
static const uint STAGE_UPDATE = 16;
static const uint STAGE_OVER = 32;

/** Runs initializer `code`, at word `op` of `m`'s program, on newborn `p`. */
void initModule<K : ICurveKeys>(Emitting m, K keys, uint op, uint code, inout ParticleInit s, inout Particle p)
{
    uint salt = m.program[op + 1];
    s.salt = salt;
    switch (code)
    {
{cases:init}
    default:
        break;
    }
}

/** Adds updater `code`'s forces on `p` to the step's. */
void forceModule<K : ICurveKeys>(Emitting m, K keys, uint op, uint code, inout ParticleStep s, Particle p)
{
    uint salt = m.program[op + 1];
    s.salt = salt;
    switch (code)
    {
{cases:force}
    default:
        break;
    }
}

/** Runs updater `code` on `p` after the step's motion. */
void afterModule<K : ICurveKeys>(Emitting m, K keys, uint op, uint code, inout ParticleStep s, inout Particle p)
{
    uint salt = m.program[op + 1];
    s.salt = salt;
    switch (code)
    {
{cases:after}
    default:
        break;
    }
}

/** Collision method `code`'s test of the step's move. */
ParticleHit collideModule<K : ICurveKeys>(Emitting m, K keys, uint op, uint code, inout ParticleStep s, Particle p)
{
    uint salt = m.program[op + 1];
    s.salt = salt;
    ParticleHit hit = noHit();
    switch (code)
    {
{cases:collide}
    default:
        break;
    }
    return hit;
}

/** Runs updater `code` on `p` after the step's collision. */
void updateModule<K : ICurveKeys>(Emitting m, K keys, uint op, uint code, inout ParticleStep s, inout Particle p)
{
    uint salt = m.program[op + 1];
    s.salt = salt;
    switch (code)
    {
{cases:update}
    default:
        break;
    }
}

/** Scales the step's attributes from birth by updater `code`'s over `p`'s life. */
void overModule<K : ICurveKeys>(Emitting m, K keys, uint op, uint code, inout ParticleStep s, Particle p)
{
    uint salt = m.program[op + 1];
    s.salt = salt;
    switch (code)
    {
{cases:over}
    default:
        break;
    }
}
