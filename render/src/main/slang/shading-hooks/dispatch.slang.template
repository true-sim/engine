    inout AroundLight light)
{
{calls:indirect}
}

/** The media hooks' change of `ray` between the camera and `p`, for the view of `block`, by override entry `entry`. */
public void mediaHooks(ShadingHookBlock* block, uint entry, uint* refused, ShadingPoint p, inout ViewRay ray)
